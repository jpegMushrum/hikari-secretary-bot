# Пример для запуска процесса бота вне Compose. Для обоих стеков используйте
# пример .env из интеграционного репозитория.
TELEGRAM_BOT_TOKEN=123456:replace_me
ADMIN_IDS=111111111,222222222
TIMEZONE=Europe/Moscow
MEDIA_DIR=/app/data/media
TARGETS_PATH=/app/targets.json
SCHEDULER_INTERVAL_SECONDS=5
MAX_DELIVERY_ATTEMPTS=5
REMINDER_OPTIONS_MINUTES=30,60,120,360,1440
# Параметры DeepSeek настраиваются в backend. Значения AI_TOPIC_* для меню
# бота должны соответствовать настройкам backend, если ИИ включён.
AI_TOPIC_TARGET_KEY=
AI_TOPIC_AUTO_PUBLISH_TIME=
AI_TOPIC_QUESTION_COUNT=5
AI_TOPIC_VOCABULARY_COUNT=10
AI_TOPIC_GRAMMAR_COUNT=3

# Оба значения обязательны для запуска бота. Токен должен совпадать с
# BOT_SERVICE_TOKEN запущенного Go backend.
BACKEND_URL=http://127.0.0.1:8080
BOT_SERVICE_TOKEN=

# HTTPS-адрес miniapp без пути, query, fragment и учётных данных.
# Добавляет кнопки «Панель клуба» и «Продолжить в панели» администраторам.
MINIAPP_URL=

# false отключает фоновый цикл доставки и уведомлений бота.
BOT_BACKGROUND_WORKERS_ENABLED=true

