TELEGRAM_BOT_TOKEN=123456:replace_me
ADMIN_IDS=111111111,222222222
TIMEZONE=Europe/Moscow
MEDIA_DIR=/app/data/media
TARGETS_PATH=/app/targets.json
SCHEDULER_INTERVAL_SECONDS=5
MAX_DELIVERY_ATTEMPTS=5
REMINDER_OPTIONS_MINUTES=30,60,120,360,1440
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=90
AI_TOPIC_TARGET_KEY=your_chat
AI_TOPIC_AUTO_PUBLISH_TIME=
AI_TOPIC_QUESTION_COUNT=5
AI_TOPIC_VOCABULARY_COUNT=10
AI_TOPIC_GRAMMAR_COUNT=3

# Заполняются только после запуска Go backend. Оба значения обязательны вместе.
BACKEND_URL=
BOT_SERVICE_TOKEN=

# Optional: https://club.example (no /admin route, query or fragment).
# Adds "Продолжить в панели" to drafts; all existing bot buttons remain.
MINIAPP_URL=

# Disable scheduled deliveries/reminders only for a local message-intake stand.
BOT_BACKGROUND_WORKERS_ENABLED=true

